PORT=5000
# Local Postgres started with `docker compose up -d` from the project root
DATABASE_URL=postgres://adnyan:adnyan_pass@localhost:5432/adnyan
# Set to true for hosted Postgres that requires SSL (Render, Neon, Supabase...)
PGSSL=false
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# First admin account, created automatically when no admin exists
ADMIN_EMAIL=admin@adnyan.org
ADMIN_PASSWORD=ChangeMe@123
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
